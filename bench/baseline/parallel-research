#!/usr/bin/env python3
"""Get a cited answer from Parallel Responses; preserve the full response on disk."""
import argparse
import json
import os
from pathlib import Path
import sys
import urllib.error
import urllib.request


def summarize(response):
    if response.get("status", "completed") != "completed":
        raise ValueError("Response not completed; inspect the saved response before retrying")
    texts, citations = [], []
    for item in response.get("output", []):
        if item.get("type") != "message":
            continue
        for part in item.get("content", []):
            if part.get("type") == "output_text":
                texts.append(part.get("text", ""))
                citations.extend(a for a in part.get("annotations", [])
                                 if a.get("type") == "url_citation")
    answer = "\n".join(texts) or response.get("output_text", "")
    if not answer.strip():
        raise ValueError("No answer text; inspect the saved response before retrying")
    return {"id": response.get("id"), "answer": answer, "citations": citations,
            "usage": response.get("usage")}


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("query", help="Complete question, or - to read stdin")
    p.add_argument("--effort", choices=["low", "medium", "high"], default="low")
    p.add_argument("--previous-response-id")
    p.add_argument("-o", "--output", type=Path, required=True, help="New JSON output file")
    p.add_argument("--dry-run", action="store_true")
    args = p.parse_args()
    query = sys.stdin.read() if args.query == "-" else args.query
    if not query.strip():
        p.error("Question must not be empty")
    payload = {"model": "parallel", "input": query, "reasoning": {"effort": args.effort},
               "instructions": "Answer the complete question with citations. Distinguish evidence from inference and state unresolved points."}
    if args.previous_response_id:
        payload["previous_response_id"] = args.previous_response_id
    if args.dry_run:
        print(json.dumps(payload, indent=2))
        return 0
    key = os.environ.get("PARALLEL_API_KEY")
    if not key:
        p.error("PARALLEL_API_KEY is missing from the environment")
    # Reserve the destination before a billable request; preserve existing files.
    with args.output.open("x", encoding="utf-8") as output:
        request = urllib.request.Request(
            "https://api.parallel.ai/v1/responses", data=json.dumps(payload).encode(),
            headers={"Authorization": "Bearer " + key, "Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(request, timeout=120) as result:
                response = json.load(result)
        except urllib.error.HTTPError as exc:
            json.dump({"request": payload, "http_status": exc.code}, output)
            print(f"Parallel HTTP {exc.code}; metadata saved to {args.output}. No automatic retry.", file=sys.stderr)
            return 1
        except (OSError, ValueError) as exc:
            json.dump({"request": payload, "error_type": type(exc).__name__}, output)
            print(f"Request failed ({type(exc).__name__}); completion unknown. No automatic retry.", file=sys.stderr)
            return 1
        json.dump({"request": payload, "response": response}, output, indent=2)
        output.write("\n")
    summary = summarize(response)
    summary["output_file"] = str(args.output)
    print(json.dumps(summary, indent=2))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as exc:
        print(f"parallel-research: {exc}", file=sys.stderr)
        sys.exit(1)
