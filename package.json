{
  "name": "@jangmanj/pi-webtasks",
  "version": "0.2.0",
  "description": "Session-bound web research tools with a local evidence store for Pi.",
  "license": "MIT",
  "author": "JangMan-J",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JangMan-J/pi-webtasks.git"
  },
  "homepage": "https://github.com/JangMan-J/pi-webtasks#readme",
  "bugs": {
    "url": "https://github.com/JangMan-J/pi-webtasks/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "parallel",
    "web-search",
    "research"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "docs:snapshot": "node scripts/snapshot-docs.mjs docs/parallel",
    "bootstrap:npm": "bash scripts/npm-bootstrap.sh"
  },
  "dependencies": {
    "parallel-web": "1.3.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.1.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "26.6.2",
    "typebox": "1.3.27",
    "typescript": "6.0.3"
  },
  "overrides": {
    "undici": "8.12.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
