{
  "name": "pi-webtasks",
  "version": "0.1.0",
  "description": "Three web research tools with durable background completion for Pi.",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "docs/advanced-sdk.md",
    "docs/api-mapping.md",
    "docs/tool-reference.md",
    "docs/webhook-integration.md",
    "docs/effort-qualification.md",
    "docs/release-readiness.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "test:live": "node scripts/live-check.ts",
    "webtasks:receiver": "node src/webhook-receiver.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "docs:snapshot": "node scripts/snapshot-docs.mjs docs/parallel"
  },
  "dependencies": {
    "parallel-web": "1.3.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.1.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.86.0",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@types/node": "26.6.2",
    "typebox": "1.3.27",
    "typescript": "6.0.3"
  }
}
