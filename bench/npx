#!/bin/sh
# Freeze only the shared skill's documented ctx7@latest command.
# Other public network/package routes remain available in both treatments.
case "$1" in
  ctx7@latest|ctx7@0.5.11|ctx7)
    shift
    exec /opt/ctx7/node_modules/.bin/ctx7 "$@"
    ;;
esac
exec node /usr/local/lib/node_modules/npm/bin/npx-cli.js "$@"
