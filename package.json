{
  "name": "pi-webtasks",
  "version": "0.1.0",
  "description": "Three web research tools with durable background completion for Pi.",
  "private": true,
  "type": "module",
  "keywords": ["pi-package"],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": ["src", "README.md", "docs/api-mapping.md", "docs/tool-reference.md", "docs/webhook-integration.md", "docs/effort-qualification.md", "docs/release-readiness.md"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "test:bench": "node --test bench/*.test.ts",
    "test:live": "node scripts/live-check.ts",
    "webtasks:receiver": "node src/webhook-receiver.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:bench": "tsc --ignoreConfig --types node --noEmit --target ES2023 --module NodeNext --moduleResolution NodeNext --allowImportingTsExtensions --skipLibCheck bench/*.ts",
    "check": "npm run typecheck && npm test",
    "check:bench": "npm run typecheck:bench && npm run test:bench && node bench/curate.ts",
    "check:all": "npm run check && npm run check:bench"
  },
  "dependencies": {
    "parallel-web": "1.3.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.86.0",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@types/node": "26.6.2",
    "typebox": "1.3.27",
    "typescript": "6.0.3"
  }
}
